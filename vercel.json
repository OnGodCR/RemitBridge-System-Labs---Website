{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/account/:path*", "destination": "/index.html" },
    { "source": "/sign-in/:path*", "destination": "/index.html" },
    { "source": "/sign-up/:path*", "destination": "/index.html" }
  ]
}
